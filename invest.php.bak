include 'db.php';
$u_id = '123456'; // টেস্ট আইডি

$res = mysqli_query($conn, "SELECT * FROM investments WHERE user_id='$u_id' AND status='active'");
?>
<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>আমার বিনিয়োগ - আল খিদমাহ</title>
    <style>
        body { font-family: sans-serif; background: #f4f4f4; padding: 15px; }
        .card { background: white; padding: 15px; border-radius: 10px; margin-bottom: 10px; border-left: 5px solid #1a2c5e; }
        .status { color: green; font-weight: bold; font-size: 12px; }
    </style>
</head>
<body>
    <h3>🏃 আমার সক্রিয় প্ল্যানসমূহ</h3>
    <?php while($row = mysqli_fetch_assoc($res)): ?>
    <div class="card">
        <p style="margin:0;"><b>বিনিয়োগ: ৳ <?php echo $row['amount']; ?></b></p>
        <p style="margin:5px 0; font-size:14px;">দৈনিক আয়: ৳ <?php echo $row['daily_profit']; ?></p>
        <p style="margin:0; font-size:12px;">অবশিষ্ট মেয়াদ: <?php echo $row['days_left']; ?> দিন</p>
        <span class="status">● রানিং</span>
    </div>
    <?php endwhile; ?>
</body>
</html>